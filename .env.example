# MongoDB
MONGODB_URI=
MONGODB_DB=gym_tracker

# Required in production. The configured account is the sole administrator.
ADMIN_USERNAME=alexioficial
ADMIN_PASSWORD=

# Base64 of exactly 32 random bytes. Generate with: openssl rand -base64 32
AUDIT_LOG_ENCRYPTION_KEY=

# Cookie security. Must match the public origin of the SvelteKit application.
# Example: https://gym.example.com
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
# Enable only behind a trusted proxy that overwrites client-IP headers.
TRUST_PROXY_HEADERS=false

# Progress photos (optional). Any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO...
# The browser uploads straight to the bucket, so its CORS must allow PUT and GET
# from FRONTEND_ORIGIN with the Content-Type header.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2/MinIO (endpoint/bucket/key); false for AWS (bucket.endpoint/key)
S3_FORCE_PATH_STYLE=false

# API listener
HOST=0.0.0.0
PORT=8080
